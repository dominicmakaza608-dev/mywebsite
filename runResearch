async function runResearch() {
    const q = document.getElementById('researchQuery').value.trim();
    const outputElement = document.getElementById('researchOutput');
    const resultBox = document.getElementById('researchResult');

    if (!q) {
        alert("Please enter a research topic.");
        return;
    }

    resultBox.classList.add('show');
    outputElement.textContent = `Searching Semantic Scholar for "${q}"...`;

    const queryEncoded = encodeURIComponent(q);

    // Escape before any innerHTML use — this was the XSS gap in the original.
    const escapeHtml = (str) =>
        String(str).replace(/[&<>"']/g, (c) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c]));
    const safeQ = escapeHtml(q);

    let papersHtml;
    try {
        const apiUrl = `https://api.semanticscholar.org/graph/v1/paper/search?query=${queryEncoded}&limit=5&fields=title,abstract,year,authors,url,venue`;
        const response = await fetch(apiUrl);
        if (!response.ok) throw new Error(`API returned ${response.status}`);
        const data = await response.json();

        if (data.data && data.data.length > 0) {
            const cards = data.data.map((paper) => {
                const title = escapeHtml(paper.title || 'Untitled');
                const authors = (paper.authors || []).map((a) => a.name).join(', ') || 'Unknown authors';
                const year = paper.year || 'n.d.';
                const venue = paper.venue ? escapeHtml(paper.venue) : '';
                const abstractRaw = paper.abstract || '';
                const abstract = abstractRaw
                    ? escapeHtml(abstractRaw.slice(0, 220)) + (abstractRaw.length > 220 ? '…' : '')
                    : 'No abstract available.';
                const link = paper.url || `https://www.semanticscholar.org/search?q=${queryEncoded}`;
                return `
                    <div class="paper-card">
                        <p class="paper-title"><a href="${link}" target="_blank" rel="noopener">${title}</a></p>
                        <p class="paper-meta">${escapeHtml(authors)} — ${year}${venue ? ' · ' + venue : ''}</p>
                        <p class="paper-abstract">${abstract}</p>
                    </div>`;
            }).join('');
            papersHtml = `<div class="paper-list">${cards}</div>`;
        } else {
            papersHtml = `<p class="paper-empty">No indexed papers found for "${safeQ}". Try the manual search links below.</p>`;
        }
    } catch (err) {
        console.error('Semantic Scholar fetch failed:', err);
        papersHtml = `<p class="paper-error">Live search failed (${escapeHtml(err.message)}). Use the manual search links below.</p>`;
    }

    outputElement.innerHTML = `
        <h4>📚 Papers matching "${safeQ}"</h4>
        ${papersHtml}

        <h4 class="research-links-heading">🔎 Search directly on academic databases</h4>
        <div class="research-links">
            <a href="https://scholar.google.com/scholar?q=${queryEncoded}" target="_blank" rel="noopener">Google Scholar</a>
            <a href="https://www.semanticscholar.org/search?q=${queryEncoded}" target="_blank" rel="noopener">Semantic Scholar</a>
            <a href="https://arxiv.org/search/?query=${queryEncoded}&searchtype=all" target="_blank" rel="noopener">arXiv</a>
        </div>
    `;
}